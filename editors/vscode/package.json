{
  "name": "pilotpatch",
  "displayName": "PilotPatch",
  "description": "Chat about your workspace and review changes from Microsoft Copilot Web.",
  "version": "0.5.0",
  "publisher": "pilotpatch-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dinesh-Das/PilotPatch.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/Dinesh-Das/PilotPatch#prompt-from-vs-code-or-cursor",
  "bugs": {"url": "https://github.com/Dinesh-Das/PilotPatch/issues"},
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Other"],
  "extensionKind": ["workspace"],
  "main": "./src/extension.js",
  "activationEvents": ["onView:pilotpatch.promptView"],
  "capabilities": {
    "untrustedWorkspaces": {"supported": false, "description": "PilotPatch runs local code and tools; trust the workspace before running it."},
    "virtualWorkspaces": {"supported": false, "description": "PilotPatch requires a local filesystem and Microsoft Edge."}
  },
  "contributes": {
    "taskDefinitions": [{"type": "pilotpatch", "required": ["runId"], "properties": {
      "runId": {"type": "string", "description": "Unique local PilotPatch invocation."}
    }}],
    "commands": [
      {"command": "pilotpatch.open", "title": "PilotPatch: Open Chat"},
      {"command": "pilotpatch.configure", "title": "PilotPatch: Select Backend Python"},
      {"command": "pilotpatch.connect", "title": "PilotPatch: Open Edge Setup"},
      {"command": "pilotpatch.login", "title": "PilotPatch: Sign In to Microsoft Copilot"},
      {"command": "pilotpatch.probe", "title": "PilotPatch: Test Copilot Connection"},
      {"command": "pilotpatch.doctor", "title": "PilotPatch: Check Setup"}
    ],
    "viewsContainers": {"activitybar": [{"id": "pilotpatch", "title": "PilotPatch", "icon": "media/pilotpatch.svg"}]},
    "views": {"pilotpatch": [{"id": "pilotpatch.promptView", "name": "Chat with your project", "type": "webview"}]},
    "configuration": {
      "title": "PilotPatch",
      "properties": {
        "pilotpatch.pythonPath": {
          "type": "string", "default": "", "scope": "machine",
          "description": "Optional absolute path to the installed backend Python. Windows setup registers a backend automatically. Set overrides in User Settings."
        }
      }
    }
  },
  "scripts": {"test": "node --test test/*.test.js"},
  "files": [
    "src/chat.js", "src/controller.js", "src/extension.js", "src/panel.js", "src/request.js", "src/review-diff.js",
    "media/panel.css", "media/panel.js", "media/pilotpatch.svg", "README.md", "LICENSE"
  ],
  "devDependencies": {}
}
