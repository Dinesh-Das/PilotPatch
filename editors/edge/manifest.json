{
  "manifest_version": 3,
  "name": "PilotPatch",
  "version": "0.4.0",
  "description": "Connect PilotPatch to the Copilot tab you choose in this Edge profile.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://copilot.com/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.ai/*",
    "http://127.0.0.1/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "PilotPatch"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
